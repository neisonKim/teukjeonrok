# Local development can leave this empty. On Vercel set your production URL.
# Example: NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=

# Statistics are OFF by default. Enable only after installing database/metrics.sql.
# NEXT_PUBLIC values are compiled at build time; redeploy after changes.
NEXT_PUBLIC_ENABLE_METRICS=false

# Server-only values. Never add NEXT_PUBLIC_ to these names.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
